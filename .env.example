# Copy to .env and fill in your values
BOT_TOKEN=
CLIENT_ID=
# Optional: register commands in a specific guild for instant availability
GUILD_ID=

# Scheduling
# Base interval cap (hours). Actual per-thread interval is min(this, auto-archive * SCHEDULE_FRACTION)
KEEPALIVE_INTERVAL_HOURS=120
# Fraction of a thread's auto-archive duration to schedule before it would archive (0.2..0.95)
SCHEDULE_FRACTION=0.7
JITTER_HOURS=12
KEEPALIVE_DELETE_DELAY_MS=2000
PORT=3000
# Data directory
DATA_DIR=./data